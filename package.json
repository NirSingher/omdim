{
  "name": "omdim",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:tunnel": "npx concurrently -k -n wrangler,ngrok -c blue,green \"wrangler dev\" \"sleep 2 && ngrok http 8787 --log=stdout\"",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "TZ=UTC vitest --config vitest.e2e.config.ts",
    "test:e2e:run": "TZ=UTC vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@slack/web-api": "^7.0.0",
    "yaml": "^2.3.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251216.0",
    "@electric-sql/pglite": "^0.5.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.16",
    "typescript": "^5.0.0",
    "vitest": "^4.0.16",
    "wrangler": "^4.95.0"
  }
}
