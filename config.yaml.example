# Omdim Configuration
# Copy this file to config.yaml and customize for your team

# Time to send manager digests (UTC, HH:MM format)
# Daily digest sent every day, weekly digest on each daily's weekly_digest_day
digest_time: "14:00"

dailies:
  - name: "engineering"
    channel: "#eng-standup"
    schedule: "i-team"
    manager: "U12345678"  # Receives automatic daily/weekly digests
    # Channel reminder: minutes before daily to post a heads-up (0 to disable, default 90)
    reminder_minutes_before: 60
    # Field order: lower numbers appear first in the modal
    # Standard fields and their defaults:
    #   unplanned (10) → review_requests (18) → today_plans (20) → my_prs (24) → blockers (30)
    # Custom questions use their own 'order' value to interleave with standard fields
    field_order:
      unplanned: 10
      review_requests: 18   # PRs to review — appears near Linear tickets, before today's plans
      today_plans: 20
      my_prs: 24             # My authored PRs — after today's plans
      blockers: 30
    questions:
      - text: "How're you feeling?"
        required: false
        order: 5      # Appears first (before unplanned)
      - text: "OOO tomorrow?"
        required: false
        order: 35     # Appears last (after blockers)

    # GitHub/Linear integrations (optional)
    # PRs and issues appear as checkboxes in the standup modal
    # Users can self-link via /standup github link or App Home buttons
    # Admin can also pre-link users with user_mapping below
    # integrations:
    #   github:
    #     enabled: true
    #     org: "your-github-org"
    #     user_mapping:                    # Optional: pre-link users
    #       - slack_user_id: "U12345678"
    #         external_username: "github-handle"
    #   linear:
    #     enabled: true
    #     team_id: "your-linear-team-id"   # Optional: omit to fetch from all teams
    #     user_mapping:
    #       - slack_user_id: "U12345678"
    #         external_username: "linear-user-uuid"

  # Example: second daily for a different team
  # - name: "product"
  #   channel: "#product-standup"
  #   schedule: "us-team"
  #   field_order:
  #     unplanned: 10
  #     review_requests: 18
  #     today_plans: 20
  #     my_prs: 24
  #     blockers: 30
  #   questions:
  #     - text: "Customer calls today?"
  #       required: false
  #       order: 15

schedules:
  - name: "i-team"
    days: [sun, mon, tue, wed, thu]
    default_time: "09:00"
    timezone: "Asia/Jerusalem"  # Required for channel reminders

  - name: "us-team"
    days: [mon, tue, wed, thu, fri]
    default_time: "09:00"
    timezone: "America/New_York"

# Slack user IDs who can manage the bot
# Find your ID: Slack profile → ⋮ menu → "Copy member ID"
admins:
  - "U12345678"

# Super admins can manage other admins (add/remove)
# Optional: if not set, admin list can only be changed by editing config
super_admins:
  - "U12345678"
